# The key is NEVER bundled into the browser build. It is used by the Vite dev
# proxy (Node side) and, in production, by the Cloudflare Worker secret:
#   npx wrangler secret put IDU_API_KEY
IDU_API_KEY=your_idu_api_key_here
IDU_ENDPOINT=https://ai.intidatautama.com/v1

# Optional. Leave unset: the client calls the same-origin path /api/ai, served
# by the Worker in production and by the dev proxy locally.
# IDU_PROXY=/api/ai
